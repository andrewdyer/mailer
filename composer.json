{
  "name": "andrewdyer/mailer",
  "description": "A framework-agnostic PHP library for sending emails from Twig templates, with support for a swappable transport interface",
  "keywords": [
    "php",
    "framework-agnostic",
    "mailer",
    "email",
    "twig",
    "smtp"
  ],
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Andrew Dyer",
      "homepage": "https://andrewdyer.rocks",
      "role": "Developer"
    }
  ],
  "homepage": "https://github.com/andrewdyer/mailer",
  "support": {
    "issues": "https://github.com/andrewdyer/mailer/issues",
    "source": "https://github.com/andrewdyer/mailer"
  },
  "autoload": {
    "psr-4": {
      "AndrewDyer\\Mailer\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "AndrewDyer\\Mailer\\Tests\\": "tests/"
    }
  },
  "require": {
    "php": "^8.3",
    "twig/twig": "^3.27"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.75",
    "phpunit/phpunit": "^10.5",
    "symfony/mailer": "^7.4"
  },
  "suggest": {
    "symfony/mailer": "Required to use SymfonyTransport (^7.4)"
  },
  "scripts": {
    "cs": "php-cs-fixer fix",
    "test": "phpunit"
  },
  "config": {
    "sort-packages": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
